{
  "name": "clawhq-openclaw-plugin",
  "version": "0.2.2",
  "description": "ClawHQ's gateway plugin for OpenClaw: one org chart, inbox and command history for every ClawHQ, and agent tools that know who called them.",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "clawhq"
  ],
  "license": "MIT",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.4"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": false
    },
    "build": {
      "openclawVersion": "2026.9.4"
    },
    "install": {
      "clawhubSpec": "clawhub:clawhq-openclaw-plugin",
      "npmSpec": "clawhq-openclaw-plugin",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.9.4"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openclaw": "2026.9.4",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surpriseawofemi/clawHQ.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/surpriseawofemi/clawHQ/tree/main/plugin",
  "author": "surpriseawofemi"
}
