<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CFBundlePackageType</key>
            <string>APPL</string>
        <key>CFBundleName</key>
            <string>ClawHQ</string>
        <key>CFBundleExecutable</key>
            <string>ClawHQ</string>
        <key>CFBundleIdentifier</key>
            <string>com.clawhq.app</string>
        <key>CFBundleVersion</key>
            <string>0.1.0</string>
        <key>CFBundleGetInfoString</key>
            <string>ClawHQ</string>
        <key>CFBundleShortVersionString</key>
            <string>0.1.0</string>
        <key>CFBundleIconFile</key>
            <string>icons</string>
        <!-- CFBundleIconName is intentionally absent: macOS 26 prefers a compiled
             Assets.car over CFBundleIconFile, and building one needs full Xcode
             (actool). Regenerate build/darwin/Assets.car from build/appicon.icon
             with `wails3 task common:generate:icons` and add
             <key>CFBundleIconName</key><string>appicon</string> back to use it. -->
        <key>LSMinimumSystemVersion</key>
            <string>12.0.0</string>
        <key>NSHighResolutionCapable</key>
            <string>true</string>
        <key>NSHumanReadableCopyright</key>
            <string>© 2026 ClawHQ contributors</string>
        <key>NSAppTransportSecurity</key>
        <dict>
            <key>NSAllowsLocalNetworking</key>
            <true/>
        </dict>
    </dict>
</plist>