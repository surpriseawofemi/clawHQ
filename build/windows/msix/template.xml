<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="clawhq.exe"
        Arguments=""
        InstallLocation="C:\Program Files\My Company\ClawHQ">
    </Installer>
    <PackageInformation
        PackageName="ClawHQ"
        PackageDisplayName="ClawHQ"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="0.2.0.0"
        PackageDescription="Desktop command center for your OpenClaw agent org">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.clawhq.app"
                Description="Desktop command center for your OpenClaw agent org"
                DisplayName="ClawHQ"
                ExecutableName="clawhq.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>ClawHQ</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>Desktop command center for your OpenClaw agent org</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="clawhq.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
